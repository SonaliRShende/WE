# Demo mode switch:
# 0 = full models (SentenceTransformer + optional dynamic/graph model loading)
# 1 = lightweight demo mode (deterministic hash embeddings, no dynamic/graph model loading)
DEMO_MODE=1

# Recommendation candidate sizing (demo defaults are enforced in code when DEMO_MODE=1)
RECOMMENDATION_CANDIDATE_LIMIT=12
RECOMMENDATION_PREFETCH_MULTIPLIER=1

MONGO_URI=
OPENROUTER_API_KEY=
FRONTEND_ORIGIN=http://localhost:5173
FLASK_DEBUG=1
FLASK_USE_RELOADER=0
PORT=5000
